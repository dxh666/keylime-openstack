#!/usr/bin/env bash
set -euo pipefail

IMAGE="${KEYLIME_OPENSTACK_IMAGE:-keylime-openstack-trust-plane:latest}"
ENV_FILE="${KEYLIME_OPENSTACK_ENV_FILE:-/etc/keylime-openstack/keylime-openstack.env}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
COMPOSE_FILE="${KEYLIME_OPENSTACK_COMPOSE_FILE:-$REPO_ROOT/deploy/compose/keylime-openstack-control-plane.yml}"

KEYLIME_OPENSTACK_ENV_FILE="$ENV_FILE" \
KEYLIME_OPENSTACK_IMAGE="$IMAGE" \
docker compose \
  --env-file "$ENV_FILE" \
  -f "$COMPOSE_FILE" \
  run --rm \
  -e PYTHONPATH=/app/backend \
  -v "$REPO_ROOT:/app:ro" \
  api \
  sh -c 'exec "${PYTHON_BIN:-python3}" -m keylime_openstack.cli "$@"' \
  keylime-openstackctl "$@"
