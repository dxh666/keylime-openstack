# OpenStack + Keylime lab variables
# Load with: source /path/to/openstack-keylime-lab.env

export OPENRC="/etc/kolla/admin-openrc.sh"
export KEYLIME_DIR="/opt/keylime-docker"
export KEYLIME_OPENSTACK_SYNC_DIR="/opt/keylime-openstack-sync"
export KEYLIME_OPENSTACK_LOG_DIR="/var/log"
export KEYLIME_OPENSTACK_STATE_DIR="/var/lib/keylime-openstack-sync"

export DOMAIN="Default"

export KEYLIME_AGENT_UUID_FIXED="11111111-1111-4111-8111-000000000009"
export KEYLIME_VERIFIER_IP="172.31.100.10"
export KEYLIME_VERIFIER_PORT="8881"
export KEYLIME_REGISTRAR_IP="172.31.100.10"
# keylime-tenant talks to registrar on 8891; keylime-agent registers on 8890.
export KEYLIME_REGISTRAR_PORT="8891"
export KEYLIME_AGENT_REGISTRAR_PORT="8890"
export KEYLIME_AGENT_BIND_IP="0.0.0.0"
export KEYLIME_AGENT_IP="172.31.100.9"
export KEYLIME_AGENT_PORT="9002"
export KEYLIME_AGENT_CONTAINER_NAME="keylime-agent"
export KEYLIME_AGENT_BASE_DIR="/opt/keylime-agent-docker"
export KEYLIME_AGENT_RELAX_TPM_PERMISSIONS="true"

export RP_NAME="csri9"
export TRUSTED_TRAIT="CUSTOM_KEYLIME_ATTESTED"
export COMPUTE_HOST="csri9"
export COMPUTE_SERVICE="nova-compute"

export TRUSTED_PROJECT="proj-boundary-a"
export TRUSTED_USER="alice-a"
export ORDINARY_PROJECT="proj-boundary-b"
export ORDINARY_USER="bob-b"
export USER_PASS="<LAB_USER_PASSWORD>"

export IMAGE="Fedora-Cloud-Base-AmazonEC2-44-1.7.x86_64.raw"
export NET_A_ID="64cef53a-83c7-49ba-beeb-2d7ea395d029"
export NET_B_ID="563d2a45-ad75-422a-b82a-0dd4e544db64"

export SOURCE_FLAVOR="m1.small"
export PUBLIC_TRUSTED_FLAVOR="trusted.keylime.small"
export PRIVATE_TRUSTED_FLAVOR="trusted.keylime.private.small"

export MAX_ATTESTATION_AGE_SECONDS="120"
