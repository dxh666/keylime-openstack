# OpenStack + Keylime lab variables
# Load with: source /path/to/openstack-keylime-lab.env

export OPENRC="/etc/kolla/admin-openrc.sh"
export KEYLIME_DIR="/opt/keylime-docker"
export KEYLIME_OPENSTACK_SYNC_DIR="/opt/keylime-openstack-sync"
export KEYLIME_OPENSTACK_LOG_DIR="/var/log"
export KEYLIME_OPENSTACK_STATE_DIR="/var/lib/keylime-openstack-sync"

export DOMAIN="Default"

export KEYLIME_AGENT_UUID_FIXED="11111111-1111-4111-8111-000000000009"
export KEYLIME_VERIFIER_IP="172.31.100.10"
export KEYLIME_VERIFIER_PORT="8881"
export KEYLIME_REGISTRAR_IP="172.31.100.10"
# keylime-tenant talks to registrar on 8891; keylime-agent registers on 8890.
export KEYLIME_REGISTRAR_PORT="8891"
export KEYLIME_AGENT_REGISTRAR_PORT="8890"
export KEYLIME_AGENT_BIND_IP="0.0.0.0"
export KEYLIME_AGENT_IP="172.31.100.9"
export KEYLIME_AGENT_PORT="9002"
export KEYLIME_AGENT_API_VERSION="2.5"
# Keylime agent inventory used by the frontend and multi-node sync loop.
# OpenStack compute nodes not listed here are still shown by the frontend as "no agent".
export KEYLIME_AGENT_INVENTORY_FILE="/etc/keylime-openstack-sync/keylime-agent-inventory.env"
export KEYLIME_AGENT_INVENTORY_JSON="/var/log/keylime-openstack-agent-inventory.json"
export KEYLIME_AGENT_INVENTORY_REFRESH="true"
export KEYLIME_AGENT_INVENTORY_REFRESH_SECONDS="60"
export KEYLIME_AGENT_INVENTORY_ALLOW_EMPTY="false"
export KEYLIME_AGENT_HOSTS="csri9,csri8"
export KEYLIME_AGENT_IP_MAP="csri9=172.31.100.9,csri8=172.31.100.8"
export KEYLIME_AGENT_UUID_MAP="csri9=11111111-1111-4111-8111-000000000009,csri8=22222222-2222-4222-8222-000000000008"
[ -r "$KEYLIME_AGENT_INVENTORY_FILE" ] && source "$KEYLIME_AGENT_INVENTORY_FILE"
export KEYLIME_AGENT_CONTAINER_NAME="keylime-agent"
export KEYLIME_AGENT_BASE_DIR="/opt/keylime-agent-docker"
export KEYLIME_AGENT_RELAX_TPM_PERMISSIONS="true"
export KEYLIME_PCR_POLICY_FILE="/var/lib/keylime-openstack-sync/tpm-pcr-policies.json"
# PCR policy apply behavior for the management console.
export KEYLIME_POLICY_APPLY_REACTIVATE="true"
export KEYLIME_POLICY_APPLY_SYNC="false"
export KEYLIME_POLICY_APPLY_SYNC_MODE="placement"
# Optional. If set, frontend write APIs require X-Admin-Token with this value.
export KEYLIME_POLICY_ADMIN_TOKEN=""
# Frontend backend collects OpenStack/Keylime state in the background.
export KEYLIME_STATUS_REFRESH_SECONDS="3"
# Optional slow fallback for VM counts when server list --long has no Host column.
export KEYLIME_VM_COUNT_SLOW_FALLBACK="false"
# Optional slow fallback when bulk resource-provider trait listing is unavailable.
export KEYLIME_TRAIT_SLOW_FALLBACK="true"
export KEYLIME_MONITOR_URL="http://172.31.100.10:8088/api/status?force=1"
# Mark existing VMs running on untrusted hosts with OpenStack server metadata.
export KEYLIME_VM_RISK_MARKER_ENABLE="true"
export KEYLIME_VM_RISK_MARKER_INTERVAL_SECONDS="60"
export KEYLIME_VM_RISK_AUDIT_FILE="/var/log/keylime-openstack-vm-risk-marker.json"

export RP_NAME="csri9"
export TRUSTED_TRAIT="CUSTOM_KEYLIME_ATTESTED"
export COMPUTE_HOST="csri9"
export COMPUTE_SERVICE="nova-compute"

export TRUSTED_PROJECT="proj-boundary-a"
export TRUSTED_USER="alice-a"
export ORDINARY_PROJECT="proj-boundary-b"
export ORDINARY_USER="bob-b"
export USER_PASS="<LAB_USER_PASSWORD>"

export IMAGE="Fedora-Cloud-Base-AmazonEC2-44-1.7.x86_64.raw"
export NET_A_ID="64cef53a-83c7-49ba-beeb-2d7ea395d029"
export NET_B_ID="563d2a45-ad75-422a-b82a-0dd4e544db64"

export SOURCE_FLAVOR="m1.small"
export PUBLIC_TRUSTED_FLAVOR="trusted.keylime.small"
export PRIVATE_TRUSTED_FLAVOR="trusted.keylime.private.small"

export MAX_ATTESTATION_AGE_SECONDS="120"
