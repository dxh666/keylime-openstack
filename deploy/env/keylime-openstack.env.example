# OpenStack + Keylime production-oriented trust plane configuration.
# Install as: /etc/keylime-openstack/keylime-openstack.env
# Recommended permissions: root:root 0600

POSTGRES_DB=keylime_openstack
POSTGRES_USER=keylime_openstack
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://keylime_openstack:change-me@postgres:5432/keylime_openstack

# Build-time controls for restricted-network environments.
PYTHON_BASE_IMAGE=python:3.12-slim
PYTHON_BIN=python3
POSTGRES_IMAGE=postgres:16
DOCKER_BUILD_NETWORK=default
INSTALL_OS_TOOLS=false
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

SERVICE_NAME=keylime-openstack
ENVIRONMENT=production
ADMIN_TOKEN=

FRONTEND_DIR=/app/deploy/frontend
TEMP_DIR=/tmp/keylime-openstack

# Kolla / Kolla-Ansible OpenStack access.
OPENSTACK_AUTH_MODE=clouds_yaml
OPENSTACK_CLOUD=admin
OPENSTACK_CLOUDS_YAML=/etc/kolla/clouds.yaml
OPENSTACK_OPENRC=/etc/kolla/admin-openrc.sh
OPENSTACK_CLI_FALLBACK=true
# Keep false until API and Placement behavior is verified in the target cluster.
OPENSTACK_ENFORCEMENT_ENABLED=false

# Keylime Docker deployment.
KEYLIME_VERIFIER_URL=https://172.31.100.10:8881
KEYLIME_REGISTRAR_URL=https://172.31.100.10:8891
KEYLIME_API_TIMEOUT_SECONDS=15
KEYLIME_TLS_VERIFY=true
KEYLIME_TLS_VERIFY_HOSTNAME=false
KEYLIME_TLS_CA_CERT=/opt/keylime-docker/varlib/cv_ca/cacert.crt
KEYLIME_TLS_CLIENT_CERT=/opt/keylime-docker/varlib/cv_ca/client-cert.crt
KEYLIME_TLS_CLIENT_KEY=/opt/keylime-docker/varlib/cv_ca/client-private.pem
KEYLIME_TENANT_TOOL_ENABLED=true
KEYLIME_DOCKER_DIR=/opt/keylime-docker
KEYLIME_DIR=/opt/keylime-docker
KEYLIME_TENANT_SERVICE=keylime-tenant
# Must match verifier.conf measured_boot_policy_name. Never use accept-all here.
KEYLIME_MEASURED_BOOT_POLICY_ENGINE=example

# Node-local policy execution. Inventory is generated from PostgreSQL; only an
# optional SSH private key needs to be mounted under this directory.
ANSIBLE_ENABLED=true
ANSIBLE_BINARY=ansible-playbook
ANSIBLE_PLAYBOOK_DIR=/app/deploy/ansible/playbooks
ANSIBLE_REMOTE_USER=root
ANSIBLE_SSH_PRIVATE_KEY_FILE=/etc/keylime-openstack/ansible/id_ed25519
ANSIBLE_KNOWN_HOSTS_FILE=/etc/keylime-openstack/ansible/known_hosts
ANSIBLE_TIMEOUT_SECONDS=900

# Shared policy/tooling paths used by the runtime-policy helper scripts.
KEYLIME_OPENSTACK_SYNC_DIR=/opt/keylime-openstack/deploy/scripts
KEYLIME_OPENSTACK_STATE_DIR=/var/lib/keylime-openstack-sync
KEYLIME_POLICY_BASE_DIR=/var/lib/keylime-openstack-sync/policies
KEYLIME_PCR_POLICY_FILE=/var/lib/keylime-openstack-sync/tpm-pcr-policies.json
KEYLIME_RUNTIME_POLICY_REGISTER_AUDIT_FILE=/var/log/keylime-openstack-runtime-policy-register.json
KEYLIME_RUNTIME_POLICY_APPLY_AUDIT_FILE=/var/log/keylime-openstack-runtime-policy-apply.json
KEYLIME_RUNTIME_POLICY_INCLUDE_BOUND_BOOT=true
KEYLIME_RUNTIME_POLICY_EXCLUDE_PROFILE=kolla-docker-host
KEYLIME_RUNTIME_POLICY_APPLY_ADD_IF_MISSING=true
KEYLIME_RUNTIME_POLICY_APPLY_NAME_MODE=unique
KEYLIME_RUNTIME_POLICY_APPLY_SYNC_MODE=api
KEYLIME_RUNTIME_POLICY_APPLY_SYNC_DELAY_SECONDS=15
KEYLIME_OPENSTACK_API_URL=http://127.0.0.1:8088
KEYLIME_OPENSTACK_API_ENV_FILE=/etc/keylime-openstack/keylime-openstack.env

# Current lab inventory. Replace these values or generate them from inventory
# discovery before deploying to a different OpenStack cluster.
KEYLIME_AGENT_HOSTS=csri8,csri9,hygon22
KEYLIME_AGENT_IP_MAP=csri8=172.31.100.8,csri9=172.31.100.9,hygon22=172.31.100.22
KEYLIME_AGENT_UUID_MAP=csri8=22222222-2222-4222-8222-000000000008,csri9=11111111-1111-4111-8111-000000000009,hygon22=33333333-3333-4333-8333-000000000022
KEYLIME_AGENT_PORT=9002

WORKER_INTERVAL_SECONDS=30
ATTESTATION_FRESH_SECONDS=120
HOST_INTEGRITY_FRESH_SECONDS=300
LEGACY_TRAIT_ENABLED=true
# ima-only / evm-disabled: Keylime IMA runtime measurement decides runtime trust.
# evm-required / ima-evm / strict: EVM/appraisal evidence must also pass.
TRUST_POLICY_MODE=ima-only

DEFAULT_CONTROLLER_HOST=csri10
DEFAULT_COMPUTE_HOSTS=csri8,csri9,hygon22

# Reserved for the next openEuler DIM integration stage.
DIM_PROVIDER_ENABLED=false
