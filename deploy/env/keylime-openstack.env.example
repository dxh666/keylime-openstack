# OpenStack + Keylime production-oriented trust plane configuration.
# Install as: /etc/keylime-openstack/keylime-openstack.env
# Recommended permissions: root:root 0600

POSTGRES_DB=keylime_openstack
POSTGRES_USER=keylime_openstack
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://keylime_openstack:change-me@postgres:5432/keylime_openstack

# Build-time controls for restricted-network environments.
PYTHON_BASE_IMAGE=python:3.12-slim
INSTALL_OS_TOOLS=false
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

SERVICE_NAME=keylime-openstack
ENVIRONMENT=production
ADMIN_TOKEN=

FRONTEND_DIR=/app/deploy/frontend
TEMP_DIR=/tmp/keylime-openstack

# Kolla / Kolla-Ansible OpenStack access.
OPENSTACK_AUTH_MODE=clouds_yaml
OPENSTACK_CLOUD=admin
OPENSTACK_CLOUDS_YAML=/etc/kolla/clouds.yaml
OPENSTACK_OPENRC=/etc/kolla/admin-openrc.sh
OPENSTACK_CLI_FALLBACK=true
# Keep false until API and Placement behavior is verified in the target cluster.
OPENSTACK_ENFORCEMENT_ENABLED=false

# Keylime Docker deployment.
KEYLIME_VERIFIER_URL=http://172.31.100.10:8881
KEYLIME_REGISTRAR_URL=http://172.31.100.10:8891
KEYLIME_TENANT_TOOL_ENABLED=true
KEYLIME_DOCKER_DIR=/opt/keylime-docker
KEYLIME_TENANT_SERVICE=keylime-tenant

WORKER_INTERVAL_SECONDS=30
ATTESTATION_FRESH_SECONDS=120
LEGACY_TRAIT_ENABLED=true

DEFAULT_CONTROLLER_HOST=csri10
DEFAULT_COMPUTE_HOSTS=csri8,csri9,hygon22

# Reserved for the next openEuler DIM integration stage.
DIM_PROVIDER_ENABLED=false
